# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Used for listing/script generation and inbound SMS coaching
CLAUDE_MODEL=claude-opus-4-6
FLASK_SECRET_KEY=change-me-use-openssl-rand-hex-32

# App environment: production | staging | development | test
# Each environment MUST use a different database.
APP_ENV=development
ENV=development
APP_URL=http://localhost:8080
PORT=8080

# Production/staging: REQUIRED — Railway PostgreSQL connection string.
# Example (auto-injected when you link Railway Postgres to the web service):
# DATABASE_URL=postgresql://user:pass@host:5432/railway
# DATABASE_URL=

# Local development/test only — ignored when DATABASE_URL is set.
# Never use SQLite for production paid-user data (ephemeral on Railway).
DATABASE_PATH=real_estate.db

# Must remain false in production/staging (startup will refuse otherwise)
ALLOW_DESTRUCTIVE_DB_RESET=false
ALLOW_SQLITE_TABLE_REBUILD=false
RUN_DEMO_SEED_ON_STARTUP=false

# Stripe (required in production) 
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Set to false to skip subscription checks in local dev
SUBSCRIPTION_REQUIRED=true

# Comma-separated emails that can access the app without a paid Stripe subscription.
# Example: demo1@example.com,demo2@example.com
FREE_ACCESS_EMAILS=

# Managed voice AI provider for AI Calling Assistant MVP
VOICE_PROVIDER=vapi
VOICE_PROVIDER_API_KEY=
VOICE_PROVIDER_WEBHOOK_SECRET=
VOICE_DEFAULT_ASSISTANT_ID=
VOICE_PHONE_NUMBER_ID=
VOICE_CALL_FROM_NUMBER=
VOICE_DAILY_CALL_LIMIT=20

# Optional Twilio SMS for AI SMS Assistant
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=
# TEMP diagnostic outbound auth + webhook RequestValidator
TWILIO_AUTH_TOKEN=
# Reserved (not used for outbound SMS during Auth Token diagnostic)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
SMS_DAILY_LIMIT=50
