# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Used for listing/script generation and inbound SMS coaching
CLAUDE_MODEL=claude-opus-4-6
FLASK_SECRET_KEY=change-me-use-openssl-rand-hex-32

# App environment: production | staging | development | test
# Each environment MUST use a different database.
# Production on Railway MUST set APP_ENV=production (primary; ENV is fallback only).
APP_ENV=development
ENV=development
APP_URL=http://localhost:8080
PORT=8080

# Production/staging: REQUIRED — Railway PostgreSQL connection string.
# Auto-injected when you link Railway Postgres to the web service.
# When set, the app uses Postgres and IGNORES DATABASE_PATH.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# Local development/test only. Remove from Railway production Variables.
# Never use SQLite for production paid-user data (ephemeral on Railway).
DATABASE_PATH=real_estate.db

# Must remain false/unset in production/staging (startup will refuse otherwise)
ALLOW_DESTRUCTIVE_DB_RESET=false
ALLOW_SQLITE_TABLE_REBUILD=false
RUN_DEMO_SEED_ON_STARTUP=false

# Safe migration (local or deploy): python -m migrations.runner
# See docs/DATABASE_SAFETY.md for Railway cutover and prohibited reset commands.

# Stripe (required in production). Use a real price_… id from Stripe Dashboard —
# placeholders like price_... will break checkout.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Monthly subscription Price ID (Dashboard → Products). Same role as STRIPE_PRICE_ID_MONTHLY.
STRIPE_PRICE_ID=price_YOUR_LIVE_OR_TEST_PRICE_ID
# Webhook endpoint (Stripe Dashboard → Developers → Webhooks):
#   POST {APP_URL}/webhook/stripe
# Events: checkout.session.completed, customer.subscription.created|updated|deleted,
#         invoice.paid, invoice.payment_failed, payment_intent.payment_failed
# Optional display override (must look like $49/month)
# SUBSCRIPTION_PRICE=$49/month
# Production APP_URL should be https://www.topairealestatetools.com (portal return → /billing)

# Set to false to skip subscription checks in local dev
SUBSCRIPTION_REQUIRED=true

# Public registration / new Checkout. Missing or not true/1/yes/on => closed.
# REGISTRATION_ENABLED=false
# Optional allowlist for private-beta testers (comma-separated, case-insensitive).
# REGISTRATION_ALLOWLIST=tester@example.com

# Transactional email for password reset (production)
# SENDGRID_API_KEY=SG....
# SMTP_FROM_EMAIL=support@topairealestatetools.com
# Or SMTP fallback:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# Comma-separated emails that can access the app without a paid Stripe subscription.
# Example: demo1@example.com,demo2@example.com
FREE_ACCESS_EMAILS=

# Managed voice AI provider for AI Calling Assistant MVP
VOICE_PROVIDER=vapi
VOICE_PROVIDER_API_KEY=
VOICE_PROVIDER_WEBHOOK_SECRET=
VOICE_DEFAULT_ASSISTANT_ID=
# Preferred assistant ID for outbound lead-qualifier calls (falls back to VOICE_DEFAULT_ASSISTANT_ID)
REAL_ESTATE_LEAD_QUALIFIER_ASSISTANT_ID=
VOICE_PHONE_NUMBER_ID=
VOICE_CALL_FROM_NUMBER=
VOICE_DAILY_CALL_LIMIT=20

# Optional Twilio SMS for AI SMS Assistant
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=

# Telnyx (active production provider). Toll-free messaging number:
# TELNYX_PHONE_NUMBER=+18888210810
# SMS_SUPPORT_DISPLAY=(888) 821-0810
# SMS_SUPPORT_E164=+18888210810
# Required for Telnyx inbound webhooks in production (Ed25519 signature verification).
# TELNYX_API_KEY=
# TELNYX_PUBLIC_KEY=
# TELNYX_MESSAGING_PROFILE_ID=
# Point the Telnyx Messaging Profile webhook to {APP_URL}/webhooks/telnyx/messaging
# AI SMS Agent: reply automatically to inbound lead SMS (requires ANTHROPIC_API_KEY).
# SMS_AI_AUTO_REPLY_ENABLED=true
# SMS_AI_MAX_REPLIES_PER_CONTACT_PER_DAY=20
# Preferred for US A2P 10DLC: Messaging Service SID (MG...). When set, outbound SMS
# uses messaging_service_sid instead of a hardcoded From number.
TWILIO_MESSAGING_SERVICE_SID=
# Outbound SMS auth + webhook RequestValidator
TWILIO_AUTH_TOKEN=
# Reserved (optional API key auth — not required when using Auth Token)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
SMS_DAILY_LIMIT=50
